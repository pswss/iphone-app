// Oneul/Secrets.swift 로 복사한 뒤 실제 값을 채우세요 (Secrets.swift는 gitignore).
// Xcode Cloud에선 ci_scripts/ci_post_clone.sh 가 환경변수로 이 파일을 생성합니다.
import Foundation

enum Secrets {
    static let pushServerURL = "https://example.com"       // LA 푸시 워커 URL
    static let pushRegisterKey = ""                        // 워커 REG_KEY와 동일한 공유키
    static let neisProxyBase = ""                          // NEIS 프록시(끝에 /), 비우면 직접 호출
    static let neisBakedKey = ""                           // 직접 호출용 NEIS 키(프록시 쓰면 비움)
}
